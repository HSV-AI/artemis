{
  "name": "artemis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-run Discord chatbot powered by PI and a configurable model provider",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bootstrap:dgraph": "node dist/dgraph-bootstrap.js",
    "check:design": "node scripts/check-design-docs.mjs",
    "check:scripts": "bash -n scripts/update-artemis-if-needed.sh",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "guardrail": "npm run lint && npm run typecheck && npm run check:scripts && npm run check:design && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1"
  }
}
