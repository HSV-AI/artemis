{
  "name": "artemis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-run Discord chatbot powered by PI and a configurable model provider",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bootstrap:dgraph": "node dist/dgraph-bootstrap.js",
    "catalog:hsvai-events": "node dist/hsvai-event-catalog-task.js",
    "check:design": "node scripts/check-design-docs.mjs",
    "check:scripts": "bash -n scripts/update-artemis-if-needed.sh",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "guardrail": "npm run lint && npm run typecheck && npm run check:scripts && npm run check:design && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
